#!/usr/bin/python3
"""Plesk mod_wrapper entrypoint. Never accepts paths, commands or environment overrides."""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from ag_core import GuardError
from ag_runtime import Runtime, install, preflight


def main(args):
    if os.geteuid() != 0:
        raise GuardError("This command must run through Plesk's privileged wrapper")
    runtime = Runtime()
    if args and args[0].startswith("runtime-"):
        from ag_versions import Versions
        versions = Versions(runtime)
        if args == ["runtime-status"]:
            return versions.status()
        if args == ["runtime-worker"]:
            return versions.worker()
        if args == ["runtime-job"]:
            payload = sys.stdin.read(65537)
            if len(payload) > 65536:
                raise GuardError("Runtime settings payload is too large")
            return versions.enqueue(json.loads(payload))
        raise GuardError("Unknown runtime command")
    if args and args[0].startswith("geoip-"):
        from ag_geoip import GeoIP
        geo = GeoIP(runtime)
        if args == ["geoip-status"]:
            return geo.status()
        if args == ["geoip-worker"]:
            return geo.worker()
        if args == ["geoip-refresh"]:
            return geo.enqueue()
        if args == ["geoip-save"]:
            payload = sys.stdin.read(65537)
            if len(payload) > 65536:
                raise GuardError("GeoIP settings payload is too large")
            return geo.enqueue(json.loads(payload))
        raise GuardError("Unknown GeoIP command")
    if args == ["preflight"]:
        return preflight()
    if args == ["install"]:
        return install()
    if args == ["status"]:
        return runtime.status()
    if args == ["status-scoped"]:
        payload = sys.stdin.read(65537)
        if len(payload) > 65536:
            raise GuardError("Status scope is too large")
        if payload.strip():
            scope = json.loads(payload)
            if not isinstance(scope, dict) or set(scope) != {"ids"} or scope['ids'] is None:
                raise GuardError("Expected an explicit domain ID scope")
            return runtime.status(scope['ids'])
        raise GuardError("Expected an explicit domain ID scope")
    if args == ["reconcile"]:
        return runtime.reconcile()
    if args == ["uninstall"]:
        return runtime.uninstall()
    if len(args) == 2 and args[0] == "save":
        payload = sys.stdin.read(65537)
        if len(payload) > 65536:
            raise GuardError("Settings payload is too large")
        return runtime.apply(args[1], json.loads(payload))
    if len(args) in (3, 4) and args[0] == "render":
        content = sys.stdin.read(4 * 1024 * 1024 + 1)
        if len(content) > 4 * 1024 * 1024:
            raise GuardError("Domain configuration is too large")
        origins = json.loads(args[3]) if len(args) == 4 else None
        if origins is not None and (not isinstance(origins, list) or len(origins) > 64 or any(not isinstance(o, str) or len(o) > 256 for o in origins)):
            raise GuardError("Invalid Plesk origin list")
        return runtime.render(args[1], args[2], content, origins)
    raise GuardError("Unknown command")


if __name__ == "__main__":
    try:
        result = main(sys.argv[1:])
        sys.stdout.write(result if isinstance(result, str) else json.dumps(result) + "\n")
    except (GuardError, ValueError, OSError, KeyError) as exc:
        # Exceptions with a traceback go to the service journal, never to panel users.
        sys.stderr.write("Anubis Guard: " + str(exc) + "\n")
        sys.exit(1)
